# Normalize line endings in the repository.
# Windows batch files MUST keep CRLF: cmd.exe mis-parses LF-only .bat files,
# which silently breaks the build (this happened to build_injector.bat).
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Visual Studio project / build files
*.sln           text eol=crlf
*.vcxproj       text eol=crlf
*.vcxproj.filters text eol=crlf
*.props         text eol=crlf

# Keep shell scripts LF
*.sh            text eol=lf

# Binary assets - never touch
*.exe           binary
*.dll           binary
*.lib           binary
*.obj           binary
*.pdb           binary
*.ico           binary
*.png           binary
*.jpg           binary
*.zip           binary
